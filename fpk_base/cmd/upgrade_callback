#!/bin/bash
# 升级后回调 - 重新本地构建镜像并重启
# 飞牛 NAS 自带 Docker 官方加速源，无需配置镜像代理
LOG_FILE="${TRIM_PKGVAR}/upgrade.log"
DOCKER_DIR="${TRIM_APPDEST}/docker"

echo "$(date '+%Y-%m-%d %H:%M:%S') - 升级：重新构建应用镜像..." >> "${LOG_FILE}"

# 检查 docker-compose.yaml
if [ ! -f "${DOCKER_DIR}/docker-compose.yaml" ]; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') - ERROR: docker-compose.yaml 不存在" >> "${LOG_FILE}"
    exit 1
fi

# 重新构建（--no-cache 确保使用最新源码）
cd "${DOCKER_DIR}"
echo "$(date '+%Y-%m-%d %H:%M:%S') - 执行 docker compose build..." >> "${LOG_FILE}"
if timeout 1800 docker compose build --no-cache >>"${LOG_FILE}" 2>&1; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') - 镜像构建成功" >> "${LOG_FILE}"
else
    echo "$(date '+%Y-%m-%d %H:%M:%S') - ERROR: 镜像构建失败" >> "${LOG_FILE}"
    exit 1
fi

# 重新创建容器
echo "$(date '+%Y-%m-%d %H:%M:%S') - 重启容器..." >> "${LOG_FILE}"
if timeout 120 docker compose up -d --force-recreate >>"${LOG_FILE}" 2>&1; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') - 容器重启成功" >> "${LOG_FILE}"
else
    echo "$(date '+%Y-%m-%d %H:%M:%S') - ERROR: 容器重启失败" >> "${LOG_FILE}"
    docker compose logs --tail=50 >>"${LOG_FILE}" 2>&1 || true
    exit 1
fi

echo "$(date '+%Y-%m-%d %H:%M:%S') - 升级完成" >> "${LOG_FILE}"
exit 0
