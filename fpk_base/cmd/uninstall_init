#!/bin/bash
# 卸载前 - 停止并移除容器
LOG_FILE="${TRIM_PKGVAR}/uninstall.log"
DOCKER_DIR="${TRIM_APPDEST}/docker"
CONTAINER_NAME="edgeone-domain-manage"

mkdir -p "${TRIM_PKGVAR}"

echo "$(date '+%Y-%m-%d %H:%M:%S') - 开始卸载..." >> "${LOG_FILE}"

if [ -f "${DOCKER_DIR}/docker-compose.yaml" ]; then
    cd "${DOCKER_DIR}"
    docker compose down >>"${LOG_FILE}" 2>&1 || true
fi

docker stop "${CONTAINER_NAME}" >>"${LOG_FILE}" 2>&1 || true
docker rm "${CONTAINER_NAME}" >>"${LOG_FILE}" 2>&1 || true

echo "$(date '+%Y-%m-%d %H:%M:%S') - 容器已停止" >> "${LOG_FILE}"
exit 0
