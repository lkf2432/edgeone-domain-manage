#!/bin/bash
# 安装后回调 - 本地构建应用镜像并启动容器
# 飞牛 NAS 自带 Docker 官方加速源，无需配置镜像代理
LOG_FILE="${TRIM_PKGVAR}/install.log"
DOCKER_DIR="${TRIM_APPDEST}/docker"

mkdir -p "${TRIM_PKGVAR}"

echo "$(date '+%Y-%m-%d %H:%M:%S') - 开始安装 EdgeOne 域名管理" >> "${LOG_FILE}"
echo "$(date '+%Y-%m-%d %H:%M:%S') - TRIM_APPDEST=${TRIM_APPDEST}" >> "${LOG_FILE}"
echo "$(date '+%Y-%m-%d %H:%M:%S') - TRIM_PKGVAR=${TRIM_PKGVAR}" >> "${LOG_FILE}"
echo "$(date '+%Y-%m-%d %H:%M:%S') - DOCKER_DIR=${DOCKER_DIR}" >> "${LOG_FILE}"

# 检查 docker-compose.yaml
if [ ! -f "${DOCKER_DIR}/docker-compose.yaml" ]; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') - ERROR: docker-compose.yaml 不存在于 ${DOCKER_DIR}" >> "${LOG_FILE}"
    ls -la "${DOCKER_DIR}" >> "${LOG_FILE}" 2>&1
    exit 1
fi

# ---------- 步骤1：本地构建应用镜像 ----------
echo "$(date '+%Y-%m-%d %H:%M:%S') - 开始构建应用镜像..." >> "${LOG_FILE}"
cd "${DOCKER_DIR}"

# 先尝试使用缓存，失败则 --no-cache 重试
BUILD_OK=0
if timeout 1800 docker compose build >>"${LOG_FILE}" 2>&1; then
    BUILD_OK=1
else
    echo "$(date '+%Y-%m-%d %H:%M:%S') - 缓存构建失败，尝试无缓存重建..." >> "${LOG_FILE}"
    if timeout 1800 docker compose build --no-cache >>"${LOG_FILE}" 2>&1; then
        BUILD_OK=1
    fi
fi

if [ "${BUILD_OK}" -eq 0 ]; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') - ERROR: 应用镜像构建失败" >> "${LOG_FILE}"
    exit 1
fi
echo "$(date '+%Y-%m-%d %H:%M:%S') - 应用镜像构建成功" >> "${LOG_FILE}"

# ---------- 步骤2：启动容器 ----------
echo "$(date '+%Y-%m-%d %H:%M:%S') - 启动容器..." >> "${LOG_FILE}"
if timeout 120 docker compose up -d >>"${LOG_FILE}" 2>&1; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') - 容器启动成功" >> "${LOG_FILE}"
else
    echo "$(date '+%Y-%m-%d %H:%M:%S') - ERROR: 容器启动失败" >> "${LOG_FILE}"
    docker compose logs --tail=50 >>"${LOG_FILE}" 2>&1 || true
    exit 1
fi

# ---------- 步骤3：等待应用就绪（最多 60 秒） ----------
echo "$(date '+%Y-%m-%d %H:%M:%S') - 等待应用就绪..." >> "${LOG_FILE}"
READY=0
for i in $(seq 1 12); do
    sleep 5
    if docker inspect --format='{{.State.Running}}' edgeone-domain-manage 2>/dev/null | grep -q true; then
        if curl -sSf --max-time 3 "http://127.0.0.1:8196/api/auth/status" >/dev/null 2>&1; then
            READY=1
            break
        fi
        # 容器在跑就认为 OK
        READY=1
        break
    fi
done

if [ "${READY}" -eq 1 ]; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') - 应用已就绪" >> "${LOG_FILE}"
else
    echo "$(date '+%Y-%m-%d %H:%M:%S') - WARNING: 应用就绪超时，请稍后手动检查" >> "${LOG_FILE}"
fi

echo "$(date '+%Y-%m-%d %H:%M:%S') - 安装完成" >> "${LOG_FILE}"
exit 0
