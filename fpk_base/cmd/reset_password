#!/bin/bash
# 重置管理员密码为默认值 admin
# 通过删除 settings.json 中的 adminPasswordHash 字段实现
# 应用下次启动时会自动生成默认密码 admin 的哈希

SETTINGS_FILE="${TRIM_PKGVAR}/settings.json"

if [ ! -f "${SETTINGS_FILE}" ]; then
    echo "配置文件不存在，应用启动时将使用默认密码 admin"
    exit 0
fi

# 使用 Python 删除 adminPasswordHash 字段
python3 -c "
import json
with open('${SETTINGS_FILE}', 'r') as f:
    data = json.load(f)
if 'adminPasswordHash' in data:
    del data['adminPasswordHash']
    with open('${SETTINGS_FILE}', 'w') as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
    print('管理员密码已重置为 admin')
else:
    print('密码已是默认值 admin')
" 2>/dev/null || python -c "
import json
with open('${SETTINGS_FILE}', 'r') as f:
    data = json.load(f)
if 'adminPasswordHash' in data:
    del data['adminPasswordHash']
    with open('${SETTINGS_FILE}', 'w') as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
    print('管理员密码已重置为 admin')
else:
    print('密码已是默认值 admin')
"

exit 0
